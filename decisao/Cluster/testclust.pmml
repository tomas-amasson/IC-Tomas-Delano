  <DataDictionary numberOfFields="5">
    <DataField name="tempo" optype="continuous" dataType="double">
      <Interval closure="closedClosed" leftMargin="0.0" rightMargin="1.0"/>
    </DataField>
    <DataField name="level" optype="continuous" dataType="double">
      <Interval closure="closedClosed" leftMargin="0.0" rightMargin="1.0"/>
    </DataField>
    <DataField name="Taxa de Sucesso" optype="continuous" dataType="double">
      <Interval closure="closedClosed" leftMargin="0.0" rightMargin="1.0"/>
    </DataField>
    <DataField name="Velocidade de Resposta" optype="continuous" dataType="double">
      <Interval closure="closedClosed" leftMargin="0.0" rightMargin="1.0"/>
    </DataField>
    <DataField name="npower" optype="continuous" dataType="double">
      <Interval closure="closedClosed" leftMargin="0.0" rightMargin="1.0"/>
    </DataField>
  </DataDictionary>
  <ClusteringModel modelName="k-means" functionName="clustering" modelClass="centerBased" numberOfClusters="3">
    <MiningSchema>
      <MiningField name="level" invalidValueTreatment="asIs"/>
      <MiningField name="Taxa de Sucesso" invalidValueTreatment="asIs"/>
      <MiningField name="Velocidade de Resposta" invalidValueTreatment="asIs"/>
      <MiningField name="npower" invalidValueTreatment="asIs"/>
    </MiningSchema>
    <ComparisonMeasure kind="distance">
      <squaredEuclidean/>
    </ComparisonMeasure>
    <ClusteringField field="level" compareFunction="absDiff"/>
    <ClusteringField field="Taxa de Sucesso" compareFunction="absDiff"/>
    <ClusteringField field="Velocidade de Resposta" compareFunction="absDiff"/>
    <ClusteringField field="npower" compareFunction="absDiff"/>
